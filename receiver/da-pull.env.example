# Direct Action · the pull bridge's settings. Copy to /etc/da-pull.env and fill in; keep it readable only by root and da:
#   sudo install -m 640 -o root -g da da-pull.env.example /etc/da-pull.env

# where the queue is, and which printer this is (the approval page, PRINTERS, PAIR A PRINTER, gives both and the token)
DA_SERVER=https://novel.global
DA_PRINTER=pickles
DA_TOKEN=

# printd on this Pi: https://github.com/HansF/printd
PRINTD_URL=http://127.0.0.1:8080
PRINTD_API_KEY=

# characters a line holds on this paper: 42 on 80 mm (Epson TM-T88V, font A), 32 on 58 mm
DA_COLS=42

# a Meshtastic radio plugged into this Pi, for each slip's mesh line: leave empty for none; 'auto', or a device such as /dev/ttyACM0
DA_MESH=

# seconds between asks when nothing is waiting
DA_POLL=3
